// Claude in a box: open this repo in VS Code, run "Dev Containers: Reopen in Container",
// then run `claude` in the container's terminal. Commands Claude runs stay in the container.
// Only for repos you trust: https://code.claude.com/docs/en/devcontainer
{
  "name": "Claude Code Black Belt",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "remoteUser": "node",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // optional token from `claude setup-token` in .devcontainer/.env (git-ignored, see .env.example);
  // the file is created empty on your machine if it is missing, so the container always starts
  "initializeCommand": ["node", "-e", "require('fs').appendFileSync('.devcontainer/.env', '')"],
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.devcontainer/.env"],
  // keep the sign-in and settings across rebuilds, one volume per repo
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    // the commands Claude runs don't see the token; Claude Code keeps it for its own calls
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  // the Bash sandbox needs bubblewrap and socat on Linux; without them commands run unsandboxed
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y bubblewrap socat && npm --prefix slides install",
  // the named volume is created root-owned; hand it to node so sessions and sign-in can be saved,
  // then merge the nested-sandbox key into the container user's settings (never into the repo's)
  "postStartCommand": "sudo chown -R node:node /home/node/.claude && node .devcontainer/user-settings.js",
  "forwardPorts": [3030]
}
